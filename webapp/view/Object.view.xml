<mvc:View
    controllerName="baclaude.controller.Object"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    height="100%">

    <uxap:ObjectPageLayout
        id="objectPageLayout"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        preserveHeaderStateOnScroll="false"
        headerContentPinnable="true"
        toggleHeaderOnTitleClick="true"
        upperCaseAnchorBar="false"
        showFooter="{view>/editMode}">

        <!-- ============================================================ -->
        <!-- Header title: invoice number + vendor + back action          -->
        <!-- ============================================================ -->
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="objectPageHeaderTitle">
                <uxap:heading>
                    <Title id="objectPageHeading"
                        text="{InvoiceNumber}"
                        level="H2"
                        wrapping="true"/>
                </uxap:heading>
                <uxap:expandedHeading>
                    <Title id="objectPageExpandedHeading"
                        text="{InvoiceNumber}"
                        level="H2"
                        wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <VBox id="objectPageSnappedHeadingBox">
                        <Title id="objectPageSnappedHeading"
                            text="{InvoiceNumber}"
                            level="H2"
                            wrapping="true"/>
                        <Text id="objectPageSnappedSubHeading"
                            text="{VendorName}"/>
                    </VBox>
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <Text id="objectPageExpandedSubtitle"
                        text="{VendorName}"/>
                </uxap:expandedContent>
                <uxap:snappedTitleOnMobile>
                    <Title id="objectPageSnappedMobileTitle"
                        text="{InvoiceNumber}"
                        level="H2"/>
                </uxap:snappedTitleOnMobile>
                <uxap:navigationActions>
                    <Button id="objectNavBack"
                        icon="sap-icon://nav-back"
                        tooltip="{i18n>actionBack}"
                        type="Transparent"
                        press=".onNavBack"/>
                </uxap:navigationActions>
                <uxap:actions>
                    <Button id="objectEditButton"
                        text="{i18n>actionEdit}"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        press=".onEdit"
                        visible="{= !${view>/editMode} }"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <!-- ============================================================ -->
        <!-- Header content: status + key amounts                         -->
        <!-- ============================================================ -->
        <uxap:headerContent>
            <HBox id="objectHeaderStatusBox" alignItems="Center" wrap="Wrap">
                <VBox id="objectHeaderStatusInner" class="sapUiSmallMarginEnd">
                    <Label id="objectHeaderStatusLabel" text="{i18n>colStatus}"/>
                    <ObjectStatus
                        id="objectHeaderStatus"
                        text="{ path: 'Status', formatter: '.formatter.statusText' }"
                        state="{ path: 'Status', formatter: '.formatter.statusState' }"
                        icon="{ path: 'Status', formatter: '.formatter.statusIcon' }"
                        inverted="true"/>
                </VBox>
            </HBox>
            <VBox id="objectHeaderNetBox" class="sapUiSmallMarginEnd">
                <Label id="objectHeaderNetLabel" text="{i18n>objectFieldNetAmount}"/>
                <ObjectNumber
                    id="objectHeaderNetAmount"
                    number="{ parts: [{path: 'NetAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                    unit="{Currency}"
                    emphasized="false"/>
            </VBox>
            <VBox id="objectHeaderGrossBox">
                <Label id="objectHeaderGrossLabel" text="{i18n>objectFieldGrossAmount}"/>
                <ObjectNumber
                    id="objectHeaderGrossAmount"
                    number="{ parts: [{path: 'GrossAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                    unit="{Currency}"
                    emphasized="true"/>
            </VBox>
        </uxap:headerContent>

        <!-- ============================================================ -->
        <!-- Sections                                                     -->
        <!-- ============================================================ -->
        <uxap:sections>

            <!-- General / Overview -->
            <uxap:ObjectPageSection id="sectionGeneral" title="{i18n>objectSectionGeneral}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionGeneral">
                        <uxap:blocks>
                            <form:SimpleForm id="formGeneral"
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2"
                                labelSpanS="12"
                                labelSpanM="4"
                                labelSpanL="4"
                                labelSpanXL="4"
                                emptySpanS="0"
                                emptySpanM="0"
                                emptySpanL="0"
                                emptySpanXL="0">
                                <Label id="lblInvoiceNumber" text="{i18n>objectFieldInvoiceNumber}"/>
                                <Text id="txtInvoiceNumber" text="{InvoiceNumber}"/>

                                <Label id="lblReferenceNumber" text="{i18n>objectFieldReference}"/>
                                <Text id="txtReferenceNumber" text="{ReferenceNumber}"/>

                                <Label id="lblVendor" text="{i18n>objectFieldVendor}"/>
                                <Text id="txtVendor" text="{VendorName}"
                                    visible="{= !${view>/editMode} }"/>
                                <Input id="inpVendor"
                                    value="{VendorName}"
                                    maxLength="80"
                                    visible="{view>/editMode}"/>

                                <Label id="lblVendorId" text="{i18n>objectFieldVendorId}"/>
                                <Text id="txtVendorId" text="{VendorId}"/>

                                <Label id="lblCompanyCode" text="{i18n>objectFieldCompanyCode}"/>
                                <Text id="txtCompanyCode" text="{CompanyCode}"/>

                                <Label id="lblPaymentTerms" text="{i18n>objectFieldPaymentTerms}"/>
                                <Text id="txtPaymentTerms" text="{PaymentTerms}"/>

                                <Label id="lblCreatedBy" text="{i18n>objectFieldCreatedBy}"/>
                                <Text id="txtCreatedBy" text="{CreatedBy}"/>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Dates -->
            <uxap:ObjectPageSection id="sectionDates" title="{i18n>objectSectionDates}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionDates">
                        <uxap:blocks>
                            <form:SimpleForm id="formDates"
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2"
                                labelSpanS="12"
                                labelSpanM="4"
                                labelSpanL="4"
                                labelSpanXL="4"
                                emptySpanS="0"
                                emptySpanM="0"
                                emptySpanL="0"
                                emptySpanXL="0">
                                <Label id="lblInvoiceDate" text="{i18n>objectFieldInvoiceDate}"/>
                                <Text id="txtInvoiceDate"
                                    text="{ path: 'InvoiceDate', formatter: '.formatter.formatDate' }"/>

                                <Label id="lblDueDate" text="{i18n>objectFieldDueDate}"/>
                                <Text id="txtDueDate"
                                    text="{ path: 'DueDate', formatter: '.formatter.formatDate' }"
                                    visible="{= !${view>/editMode} }"/>
                                <DatePicker id="dpDueDate"
                                    dateValue="{DueDate}"
                                    valueFormat="yyyy-MM-dd"
                                    visible="{view>/editMode}"/>

                                <Label id="lblPostingDate" text="{i18n>objectFieldPostingDate}"/>
                                <Text id="txtPostingDate"
                                    text="{ path: 'PostingDate', formatter: '.formatter.formatDate' }"/>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Amounts -->
            <uxap:ObjectPageSection id="sectionAmounts" title="{i18n>objectSectionAmounts}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionAmounts">
                        <uxap:blocks>
                            <form:SimpleForm id="formAmounts"
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="2"
                                columnsL="2"
                                columnsXL="2"
                                labelSpanS="12"
                                labelSpanM="4"
                                labelSpanL="4"
                                labelSpanXL="4"
                                emptySpanS="0"
                                emptySpanM="0"
                                emptySpanL="0"
                                emptySpanXL="0">
                                <Label id="lblNetAmount" text="{i18n>objectFieldNetAmount}"/>
                                <ObjectNumber
                                    id="numNetAmount"
                                    number="{ parts: [{path: 'NetAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                                    unit="{Currency}"
                                    emphasized="false"/>

                                <Label id="lblTaxAmount" text="{i18n>objectFieldTaxAmount}"/>
                                <ObjectNumber
                                    id="numTaxAmount"
                                    number="{ parts: [{path: 'TaxAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                                    unit="{Currency}"
                                    emphasized="false"/>

                                <Label id="lblGrossAmount" text="{i18n>objectFieldGrossAmount}"/>
                                <ObjectNumber
                                    id="numGrossAmount"
                                    number="{ parts: [{path: 'GrossAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                                    unit="{Currency}"
                                    emphasized="true"/>

                                <Label id="lblCurrency" text="{i18n>objectFieldCurrency}"/>
                                <Text id="txtCurrency" text="{Currency}"
                                    visible="{= !${view>/editMode} }"/>
                                <Input id="inpCurrency"
                                    value="{Currency}"
                                    maxLength="5"
                                    visible="{view>/editMode}"/>

                                <Label id="lblStatus" text="{i18n>objectFieldStatus}"/>
                                <ObjectStatus
                                    id="statusFormStatus"
                                    text="{ path: 'Status', formatter: '.formatter.statusText' }"
                                    state="{ path: 'Status', formatter: '.formatter.statusState' }"
                                    icon="{ path: 'Status', formatter: '.formatter.statusIcon' }"
                                    inverted="true"/>
                            </form:SimpleForm>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Line items -->
            <uxap:ObjectPageSection id="sectionItems" title="{i18n>objectSectionItems}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionItems">
                        <uxap:blocks>
                            <Table id="itemsTable"
                                items="{Items}"
                                growing="true"
                                growingThreshold="50"
                                updateFinished=".onItemsUpdateFinished"
                                noDataText="{i18n>itemsTableNoData}">
                                <headerToolbar>
                                    <OverflowToolbar id="itemsTableToolbar">
                                        <Title id="itemsTableTitle" text="{i18n>objectSectionItems}"/>
                                        <ToolbarSpacer id="itemsTableSpacer"/>
                                        <Button id="itemsAddButton"
                                            text="{i18n>actionAddItem}"
                                            icon="sap-icon://add"
                                            press=".onAddItem"
                                            visible="{view>/editMode}"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="colItemDescription">
                                        <Text text="{i18n>colItemDescription}"/>
                                    </Column>
                                    <Column id="colItemQuantity" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>colItemQuantity}"/>
                                    </Column>
                                    <Column id="colItemUnitPrice" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>colItemUnitPrice}"/>
                                    </Column>
                                    <Column id="colItemTaxRate" hAlign="End" minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>colItemTaxRate}"/>
                                    </Column>
                                    <Column id="colItemAmount" hAlign="End">
                                        <Text text="{i18n>colItemAmount}"/>
                                    </Column>
                                    <Column id="colItemActions" hAlign="End" width="3rem"
                                        visible="{view>/editMode}">
                                        <Text id="colItemActionsHeader" text=""/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Input value="{Description}"
                                                editable="{view>/editMode}"
                                                change=".onItemChange"/>
                                            <Input value="{Quantity}"
                                                type="Number"
                                                textAlign="End"
                                                editable="{view>/editMode}"
                                                change=".onItemChange"/>
                                            <Input value="{UnitPrice}"
                                                type="Number"
                                                textAlign="End"
                                                editable="{view>/editMode}"
                                                change=".onItemChange"/>
                                            <Input value="{TaxRate}"
                                                type="Number"
                                                textAlign="End"
                                                editable="{view>/editMode}"
                                                change=".onItemChange"/>
                                            <ObjectNumber
                                                number="{ parts: [{path: 'NetAmount'}, {path: 'Currency'}], formatter: '.formatter.formatAmount' }"
                                                unit="{Currency}"/>
                                            <Button
                                                id="itemDeleteButton"
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="{i18n>actionDeleteItem}"
                                                press=".onDeleteItem"
                                                visible="{view>/editMode}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Tax positions (aggregated from the line items by tax rate) -->
            <uxap:ObjectPageSection id="sectionTaxItems" title="{i18n>objectSectionTaxItems}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionTaxItems">
                        <uxap:blocks>
                            <Table id="taxItemsTable"
                                items="{view>/taxItems}"
                                noDataText="{i18n>taxItemsTableNoData}">
                                <headerToolbar>
                                    <OverflowToolbar id="taxItemsTableToolbar">
                                        <Title id="taxItemsTableTitle" text="{i18n>objectSectionTaxItems}"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column id="colTaxRate" hAlign="End">
                                        <Text id="colTaxRateHeader" text="{i18n>colTaxRate}"/>
                                    </Column>
                                    <Column id="colTaxBase" hAlign="End">
                                        <Text id="colTaxBaseHeader" text="{i18n>colTaxBase}"/>
                                    </Column>
                                    <Column id="colTaxAmount" hAlign="End">
                                        <Text id="colTaxAmountHeader" text="{i18n>colTaxAmount}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="taxItemsRow">
                                        <cells>
                                            <Text id="taxItemRate"
                                                text="{ path: 'view>TaxRate', formatter: '.formatter.formatTaxRate' }"/>
                                            <ObjectNumber id="taxItemBase"
                                                number="{ parts: [{path: 'view>TaxBase'}, {path: 'view>Currency'}], formatter: '.formatter.formatAmount' }"
                                                unit="{view>Currency}"/>
                                            <ObjectNumber id="taxItemAmount"
                                                number="{ parts: [{path: 'view>TaxAmount'}, {path: 'view>Currency'}], formatter: '.formatter.formatAmount' }"
                                                unit="{view>Currency}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

        </uxap:sections>

        <!-- ============================================================ -->
        <!-- Footer: save / cancel (only visible in edit mode)            -->
        <!-- ============================================================ -->
        <uxap:footer>
            <OverflowToolbar id="objectFooterToolbar">
                <ToolbarSpacer id="objectFooterSpacer"/>
                <Button id="objectSaveButton"
                    text="{i18n>actionSave}"
                    type="Emphasized"
                    press=".onSave"/>
                <Button id="objectCancelButton"
                    text="{i18n>actionCancel}"
                    press=".onCancel"/>
            </OverflowToolbar>
        </uxap:footer>

    </uxap:ObjectPageLayout>

</mvc:View>
