<mvc:View
    controllerName="baclaude.controller.Worklist"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    height="100%">

    <f:DynamicPage id="page" toggleHeaderOnTitleClick="true" showFooter="false" preserveHeaderStateOnScroll="false" fitContent="true">

        <!-- ============================================================ -->
        <!-- Title area                                                   -->
        <!-- ============================================================ -->
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title id="pageHeadingTitle" text="{i18n>worklistTitle}" level="H2"/>
                </f:heading>
                <f:expandedHeading>
                    <Title id="pageExpandedHeadingTitle" text="{i18n>worklistTitle}" level="H2"/>
                </f:expandedHeading>
                <f:snappedHeading>
                    <HBox id="snappedHeadingBox" alignItems="Center" wrap="Wrap">
                        <Title id="snappedHeadingTitle" text="{i18n>worklistTitle}" level="H2"/>
                        <ObjectNumber
                            id="snappedHeadingCount"
                            class="sapUiTinyMarginBegin"
                            number="{view>/itemCount}"
                            unit="{i18n>worklistResultsLabel}"
                            emphasized="false"/>
                    </HBox>
                </f:snappedHeading>
                <f:expandedContent>
                    <Text id="expandedSubtitle" text="{i18n>worklistSubtitle}"/>
                </f:expandedContent>
                <f:snappedContent>
                    <Text id="snappedSubtitle" text="{i18n>worklistSubtitle}"/>
                </f:snappedContent>
                <f:actions>
                    <Button
                        id="actionRefreshButton"
                        text="{i18n>actionRefresh}"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- ============================================================ -->
        <!-- Filter header                                                -->
        <!-- ============================================================ -->
        <f:header>
            <f:DynamicPageHeader id="pageHeader" pinnable="true">
                <!-- SmartFilterBar – filter fields are generated automatically from the
                     OData metadata of the "Invoices" entity set. It is linked to the
                     SmartTable below via the table's "smartFilterId" so that pressing
                     "Go" (or the basic search) triggers a filtered OData request. -->
                <smartFilterBar:SmartFilterBar
                    id="invoiceFilterBar"
                    entitySet="Invoices"
                    persistencyKey="invoiceFilterBar"
                    enableBasicSearch="true"
                    useToolbar="true"
                    initialized=".onFilterBarInitialized"
                    search=".onFilterBarSearch"/>
            </f:DynamicPageHeader>
        </f:header>

        <!-- ============================================================ -->
        <!-- Content – Invoice table                                      -->
        <!-- ============================================================ -->
        <f:content>
            <VBox id="contentBox" fitContainer="true">

                <!-- ==================================================== -->
                <!-- Chart – invoice count per month                      -->
                <!-- ==================================================== -->
                <Panel
                    id="chartPanel"
                    headerText="{i18n>chartPanelTitle}"
                    expandable="true"
                    expanded="true"
                    width="auto"
                    class="sapUiResponsiveMargin">
                    <viz:VizFrame
                        id="invoiceChart"
                        vizType="column"
                        height="320px"
                        width="100%"
                        uiConfig="{applicationSet:'fiori'}">
                        <viz:dataset>
                            <viz.data:FlattenedDataset id="chartDataset" data="{chart>/months}">
                                <viz.data:dimensions>
                                    <viz.data:DimensionDefinition
                                        id="chartDimMonth"
                                        name="Monat"
                                        value="{chart>month}"/>
                                </viz.data:dimensions>
                                <viz.data:measures>
                                    <viz.data:MeasureDefinition
                                        id="chartMeasureCount"
                                        name="Rechnungen"
                                        value="{chart>count}"/>
                                </viz.data:measures>
                            </viz.data:FlattenedDataset>
                        </viz:dataset>
                        <viz:feeds>
                            <viz.feeds:FeedItem
                                id="chartFeedValue"
                                uid="valueAxis"
                                type="Measure"
                                values="Rechnungen"/>
                            <viz.feeds:FeedItem
                                id="chartFeedCategory"
                                uid="categoryAxis"
                                type="Dimension"
                                values="Monat"/>
                        </viz:feeds>
                    </viz:VizFrame>
                </Panel>

                <!-- ==================================================== -->
                <!-- Invoice table (SmartTable)                           -->
                <!-- ==================================================== -->
                <!-- Columns are generated automatically from the OData metadata of the
                     "Invoices" entity set. The table is connected to the SmartFilterBar
                     above in the controller: its "search" event triggers rebindTable, and
                     beforeRebindTable merges the filter bar's filters / basic search into
                     the OData request. Row navigation and the create button are wired up in
                     the controller (initialise handler / custom toolbar). -->
                <smartTable:SmartTable
                    id="invoiceSmartTable"
                    entitySet="Invoices"
                    tableType="ResponsiveTable"
                    useVariantManagement="false"
                    enableExport="false"
                    useTablePersonalisation="true"
                    header="{i18n>worklistTableTitle}"
                    showRowCount="true"
                    initiallyVisibleFields="InvoiceNumber,VendorName,InvoiceDate,GrossAmount,Currency,Status"
                    class="sapUiResponsiveContentPadding"
                    initialise=".onSmartTableInitialise"
                    beforeRebindTable=".onBeforeRebindTable">

                    <smartTable:customToolbar>
                        <OverflowToolbar id="tableToolbar">
                            <ToolbarSpacer id="tableToolbarSpacer"/>
                            <Button
                                id="createButton"
                                text="{i18n>actionCreate}"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onCreatePress"/>
                        </OverflowToolbar>
                    </smartTable:customToolbar>

                </smartTable:SmartTable>

            </VBox>
        </f:content>

    </f:DynamicPage>

</mvc:View>
